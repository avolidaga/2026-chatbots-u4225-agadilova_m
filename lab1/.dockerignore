# Secrets and environment files are never copied into the image.
**/.env
**/.env.*

# Local runtimes and caches.
**/.venv
**/venv
**/env
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/.coverage
**/htmlcov

# Private databases and backups. Production SQLite lives on a mounted volume.
**/data
**/backups
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log

# Git metadata, editor files and report images are not needed at runtime.
**/.git
**/.idea
**/.vscode
**/.DS_Store
**/report_assets
